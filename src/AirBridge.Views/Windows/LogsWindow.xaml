<Window x:Class="AirBridge.Views.Windows.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirBridge — Logs"
        Width="700" Height="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="#1E1E1E">
            <TextBlock x:Name="LogContent"
                       FontFamily="Cascadia Mono, Consolas, Courier New"
                       FontSize="12"
                       Foreground="#D4D4D4"
                       Padding="10"
                       TextWrapping="NoWrap"/>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="8" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Clear" Width="70" Height="28" Click="OnClearClick"/>
            <Button DockPanel.Dock="Right" Content="Open file" Width="80" Height="28"
                    Margin="0,0,8,0" Click="OnOpenFileClick"/>
        </DockPanel>
    </Grid>
</Window>